{
  "name": "cms-web-theme",
  "version": "1.0.0",
  "description": "University of Cambridge-identity styling (Bootstrap 5 theme + framework-agnostic CSS) for internally hosted services.",
  "license": "MIT",
  "style": "dist/cambridge-theme.css",
  "sass": "scss/cambridge-theme.scss",
  "files": [
    "css",
    "dist",
    "scss",
    "tokens",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.js",
    "build:css": "sass --load-path=node_modules --style=expanded scss/cambridge-theme.scss dist/cambridge-theme.css",
    "build:css:min": "sass --load-path=node_modules --style=compressed scss/cambridge-theme.scss dist/cambridge-theme.min.css",
    "build": "npm run build:tokens && npm run build:css && npm run build:css:min"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.0"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.77.8"
  }
}
